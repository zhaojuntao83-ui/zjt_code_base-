; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited using a text editor.

config_version=5

[application]

config/name="Master & Echo - 师与影"
config/description="横版2D动作跑酷独立游戏。玩家扮演师傅，通过亲自示范动作来教导机器人弟子学习跑酷与战斗技能。"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoloads/game_manager.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
EventBus="*res://scripts/autoloads/event_bus.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

